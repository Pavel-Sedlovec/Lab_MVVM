<UserControl x:Class="Lab_MVVM.View.DefaultBindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Lab_MVVM.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel Margin="20">
        <TextBlock Text="Введите что-нибудь:" />

        <TextBox Text="{Binding TextDB}"
                 Margin="0,5"
                 Background="LightGray" />

        <TextBlock Text="Результат во ViewModel:"
                   Margin="0,10,0,0"
                   FontWeight="Bold" />
        <TextBlock Text="{Binding TextDB }"
                   Foreground="Red"
                   FontSize="18" />

        <TextBlock Text="Инструкция:"
                   Margin="0,20,0,0"
                   Opacity="0.7" />
        <TextBlock Text="1. Начни писать текст в сером поле — красный текст НЕ МЕНЯЕТСЯ."
                   TextWrapping="Wrap" />
        <TextBlock Text="2. Нажми клавишу Tab или кликни мышкой в любое другое место."
                   TextWrapping="Wrap" />
        <TextBlock Text="3. Как только TextBox потерял фокус — красный текст обновился!"
                   TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
