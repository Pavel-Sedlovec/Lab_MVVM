<UserControl x:Class="Lab_MVVM.View.DefaultBindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Lab_MVVM.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel Margin="20">
        <TextBlock Text="{Binding Strings.t_Default, Source={StaticResource Loc}}"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,10" />

        <TextBlock Text="{Binding Strings.m_Instruction, Source={StaticResource Loc}}"
                   FontWeight="SemiBold" />
        <TextBlock Text="{Binding Strings.t_Def_Step1, Source={StaticResource Loc}}"
                   TextWrapping="Wrap" />
        <TextBlock Text="{Binding Strings.t_Def_Step2, Source={StaticResource Loc}}"
                   TextWrapping="Wrap" />
        <TextBlock Text="{Binding Strings.t_Def_Step3, Source={StaticResource Loc}}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,20" />

        <TextBlock Text="{Binding Strings.m_Input, Source={StaticResource Loc}}" />
        <TextBox x:Name="InputBox"
                 Margin="0,5"
                 Background="LightGray" />

        <TextBlock Text="{Binding Strings.m_ResultVM, Source={StaticResource Loc}}"
                   Margin="0,10,0,0" />
        <TextBlock Text="{Binding ElementName=InputBox, Path=Text}"
                   Foreground="Red"
                   FontSize="16"
                   FontWeight="Bold" />
    </StackPanel>
</UserControl>
