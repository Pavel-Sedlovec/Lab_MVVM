<Window x:Class="Lab_MVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab_MVVM.View"
        mc:Ignorable="d"        
        Title="MainWindow" Height="450" Width="800">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl>
            <TabItem Header="{DynamicResource t_Default}">
                <local:DefaultBindingView />
            </TabItem>

            <TabItem Header="{DynamicResource t_TwoWay}">
                <local:TwoWayBindingView />
            </TabItem>

            <TabItem Header="{DynamicResource t_OneTime}">
                <local:OneTimeBindingView />
            </TabItem>

            <TabItem Header="{DynamicResource t_OneWay}">
                <local:OneWayBindingView />
            </TabItem>

            <TabItem Header="{DynamicResource t_Triggers}">
                <local:TriggersView />
            </TabItem>

        </TabControl>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="10,5">
            <TextBlock Text="{DynamicResource m_LangLabel}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <ComboBox x:Name="LanguageComboBox"
                      Width="120"
                      SelectionChanged="LanguageComboBox_SelectionChanged">
                <ComboBoxItem Content="Русский"
                              Tag="ru"
                              IsSelected="True" />
                <ComboBoxItem Content="English"
                              Tag="en" />
            </ComboBox>
        </StackPanel>
    </Grid>
</Window>
