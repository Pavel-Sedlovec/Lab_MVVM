<Window x:Class="Lab_MVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab_MVVM.View"
        mc:Ignorable="d"        
        Title="MainWindow" Height="450" Width="800">
    
    <Grid>
        <TabControl>
            <TabItem Header="Привязка по умолчанию">
                <local:DefaultBindingView />
            </TabItem>

            <TabItem Header="Двухсторонняя привязка">
                <local:TwoWayBindingView />
            </TabItem>

            <TabItem Header="Одноразовая привязка">
                <local:OneTimeBindingView />
            </TabItem>

            <TabItem Header="Односторонняя привязка">
                <local:OneWayBindingView />
            </TabItem>

            <TabItem Header="Триггеры">
                <local:TriggersView />
            </TabItem>

        </TabControl>
    </Grid>
</Window>
