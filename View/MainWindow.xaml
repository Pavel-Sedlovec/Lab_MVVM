<Window x:Class="Lab_MVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab_MVVM.View"
        mc:Ignorable="d"        
        Title="MainWindow" Height="450" Width="800">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl>
            <TabItem Header="Привязка по умолчанию">
                <local:DefaultBindingView />
            </TabItem>

            <TabItem Header="Двухсторонняя привязка">
                <local:TwoWayBindingView />
            </TabItem>

            <TabItem Header="Одноразовая привязка">
                <local:OneTimeBindingView />
            </TabItem>

            <TabItem Header="Односторонняя привязка">
                <local:OneWayBindingView />
            </TabItem>

            <TabItem Header="Триггеры">
                <local:TriggersView />
            </TabItem>

        </TabControl>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Margin="10,5"
                    VerticalAlignment="Center">
            <TextBlock Text="Язык:"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"
                       FontSize="14" />
            <ComboBox x:Name="LanguageComboBox"
                      Width="120"
                      Height="30"
                      SelectionChanged="LanguageComboBox_SelectionChanged">
                <ComboBoxItem Content="Русский"
                              Tag="ru" />
                <ComboBoxItem Content="English"
                              Tag="en" />
            </ComboBox>
        </StackPanel>
    </Grid>
</Window>
