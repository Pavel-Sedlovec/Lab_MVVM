<Window x:Class="Lab_MVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Lab_MVVM.View"
        Title="Lab MVVM Binding"
        Height="550"
        Width="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl>
            <TabItem Header="{Binding Strings.t_Default, Source={StaticResource Loc}}">
                <local:DefaultBindingView />
            </TabItem>
            <TabItem Header="{Binding Strings.t_TwoWay, Source={StaticResource Loc}}">
                <local:TwoWayBindingView />
            </TabItem>
            <TabItem Header="{Binding Strings.t_OneTime, Source={StaticResource Loc}}">
                <local:OneTimeBindingView />
            </TabItem>
            <TabItem Header="{Binding Strings.t_OneWay, Source={StaticResource Loc}}">
                <local:OneWayBindingView />
            </TabItem>
            <TabItem Header="{Binding Strings.t_Triggers, Source={StaticResource Loc}}">
                <local:TriggersView />
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="10">
            <TextBlock Text="{Binding Strings.m_LangLabel, Source={StaticResource Loc}}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0" />
            <ComboBox x:Name="LanguageComboBox"
                      Width="120"
                      SelectionChanged="LanguageComboBox_SelectionChanged">
                <ComboBoxItem Content="Русский"
                              Tag="ru"
                              IsSelected="True" />
                <ComboBoxItem Content="English"
                              Tag="en" />
            </ComboBox>
        </StackPanel>
    </Grid>
</Window>