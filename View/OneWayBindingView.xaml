<UserControl x:Class="Lab_MVVM.View.OneWayBindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Lab_MVVM.View"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <StackPanel Margin="20">
        <TextBlock Text="{Tr 'OneWayBindingView.Title'}"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="DarkGreen" />

        <TextBlock Text="{Tr 'OneWayBindingView.SourceLabel'}"
                   Margin="0,10,0,0" />
        <TextBox Text="{Binding TextOWB, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,5"
                 Background="LightCyan" />

        <Separator Margin="0,20" />

        <TextBlock Text="{Tr 'OneWayBindingView.Receiver1Label'}"
                   Margin="0,10,0,0" />
        <TextBlock Text="{Binding TextOWB, Mode=OneWay}"
                   FontSize="20"
                   Foreground="DarkBlue"
                   Background="LightYellow"
                   Padding="5" />

        <TextBlock Text="{Tr 'OneWayBindingView.Receiver2Label'}"
                   Margin="0,10,0,0" />
        <TextBox Text="{Binding TextOWB, Mode=OneWay}"
                 Background="MistyRose"
                 Padding="5" />

        <TextBlock Text="{Tr 'OneWayBindingView.Instructions'}"
                   Margin="0,20"
                   Opacity="0.8"
                   TextWrapping="Wrap"
                   Foreground="Gray"
                   FontStyle="Italic" />
    </StackPanel>
</UserControl>